      "input": {
        "kind": "run",
        "argv": [
          "python",
          "-m",
          "pytest",
          "-q"
        ],
        "cwd": "."
      },
      "expected_dict": {
        "kind": "run",
        "argv": [
          "python",
          "-m",
          "pytest",
          "-q"
        ],
        "cwd": "."
      }
    },
    {
      "id": "mkdir_src_tests",
      "input": {
        "kind": "mkdir",
        "paths": [
          "src",
          "tests"
        ]
      },
      "expected_dict": {
        "kind": "mkdir",
        "paths": [
          "src",
          "tests"
        ]
      }
    },
    {
      "id": "which_git",
      "input": {
        "kind": "which",
        "name": "git"
      },
      "expected_dict": {
        "kind": "which",
        "name": "git"
      }
    },
    {
