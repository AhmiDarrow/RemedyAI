    {
      "id": "translated_mkdir_src_x",
      "kind": "prepare_command",
      "input": {
        "command": "mkdir -p src/x",
        "host": "cmd"
      },
      "expected": {
        "kind": "translated",
        "argv_template": [
          "<CMD>",
          "/c",
          "(if not exist \"src\\x\\.\" mkdir \"src\\x\")"
        ],
        "display": "(if not exist \"src\\x\\.\" mkdir \"src\\x\")",
        "translated": "(if not exist \"src\\x\\.\" mkdir \"src\\x\")",
        "notes": [
          "mkdir -p → if not exist mkdir"
        ],
        "ir": {
          "kind": "raw",
          "host": "cmd",
          "text": "(if not exist \"src\\x\\.\" mkdir \"src\\x\")"
        },
        "host": "cmd"
      }
    },
