diff --git a/.github/workflows/desktop-release.yml b/.github/workflows/desktop-release.yml
index a106ae9..0f4af53 100644
--- a/.github/workflows/desktop-release.yml
+++ b/.github/workflows/desktop-release.yml
@@ -453,7 +453,7 @@ jobs:
           retention-days: 7
 
   release:
-    needs: [verify, build-tauri, build-tauri-linux]
+    needs: [verify, build-runtime, build-runtime-linux, build-tauri, build-tauri-linux]
     runs-on: ubuntu-latest
     permissions:
       contents: write
@@ -482,6 +482,52 @@ jobs:
           name: remedy-linux
           path: dist-linux/
 
+      - name: Download Windows native runtime
+        uses: actions/download-artifact@v4
+        with:
+          name: remedy-runtime-bins
+          path: dist-native-win/
+
+      - name: Download Linux native runtime
+        uses: actions/download-artifact@v4
+        with:
+          name: remedy-runtime-linux
+          path: dist-native-linux/
+
+      - name: Stage standalone native CLI assets
+        shell: bash
+        run: |
+          set -euo pipefail
+          mkdir -p dist-native
+          if [[ -f dist-native-win/remedy-runtime-x86_64-pc-windows-msvc.exe ]]; then
+            cp dist-native-win/remedy-runtime-x86_64-pc-windows-msvc.exe dist-native/
+          elif [[ -f dist-native-win/remedy-runtime.exe ]]; then
+            cp dist-native-win/remedy-runtime.exe dist-native/remedy-runtime-x86_64-pc-windows-msvc.exe
+          fi
+          if [[ -f dist-native-win/remedy_core.dll ]]; then
+            cp dist-native-win/remedy_core.dll dist-native/remedy_core-x86_64-pc-windows-msvc.dll
+          fi
+          if [[ -f dist-native-linux/remedy-runtime-x86_64-unknown-linux-gnu ]]; then
+            cp dist-native-linux/remedy-runtime-x86_64-unknown-linux-gnu dist-native/
+          elif [[ -f dist-native-linux/remedy-runtime ]]; then
+            cp dist-native-linux/remedy-runtime dist-native/remedy-runtime-x86_64-unknown-linux-gnu
+          fi
+          if [[ -f dist-native-linux/libremedy_core.so ]]; then
+            cp dist-native-linux/libremedy_core.so dist-native/libremedy_core-x86_64-unknown-linux-gnu.so
+          fi
+          chmod +x dist-native/remedy-runtime-x86_64-unknown-linux-gnu 2>/dev/null || true
+          mapfile -t files < <(find dist-native -maxdepth 1 -type f \( -name 'remedy-runtime-*' -o -name '*remedy_core*' \) | sort)
+          if [[ ${#files[@]} -eq 0 ]]; then
+            echo "::error::No standalone remedy-runtime / remedy_core assets to publish"
+            exit 1
+          fi
+          (
+            cd dist-native
+            sha256sum -- "${files[@]#dist-native/}" | sort
+          ) > dist-native/remedy-native-SHA256SUMS.txt
+          echo "Published native CLI assets:"
+          cat dist-native/remedy-native-SHA256SUMS.txt
+
       - name: Get installer filename and signature
         id: installer
         shell: bash
@@ -599,10 +645,18 @@ jobs:
 
             No Python, Node, or Rust required.
 
+            ### CLI runtime (``pip install remedy-ai``)
+
+            This release also attaches standalone ``remedy-runtime`` / ``remedy_core``
+            binaries and ``remedy-native-SHA256SUMS.txt``. First ``remedy serve`` on a
+            PyPI install downloads the pair for this OS, verifies the checksum, and
+            caches them under ``~/.remedy/runtime/``.
+
             ### Auto-update
             This release is **minisign-signed**. Windows NSIS and Linux AppImage installs with the embedded updater pubkey (v0.10.2+) can check and install updates in-app. Linux `.deb` installs still update from this page (`sudo apt install` the new `.deb`).
           files: |
             dist/${{ steps.installer.outputs.name }}
             dist/latest.json
             dist-linux/*
+            dist-native/*
           generate_release_notes: true
