{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Remedy Desktop",
  "version": "0.19.0",
  "identifier": "com.remedy.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Remedy Desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": true,
        "decorations": true,
        "shadow": true,
        "theme": "Dark"
      }
    ],
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/tray-icon@2x.png",
      "iconAsTemplate": false,
      "tooltip": "Remedy",
      "showMenuOnLeftClick": false
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:7400 http://localhost:7400 https: http:; img-src 'self' data: blob: asset: http://asset.localhost http://127.0.0.1:7400 http://localhost:7400 https: http:; font-src 'self' data:; frame-src https: http: data: blob:; child-src https: http: data: blob:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "publisher": "Remedy",
    "copyright": "Copyright (c) 2025-2026 Ahmi Darrow",
    "category": "DeveloperTool",
    "shortDescription": "Local AI partner for knowledge, design, and code",
    "longDescription": "Remedy Desktop is a local-first AI partner. The app and sidecar run on your PC; optional local vision downloads a pinned open model you control. Install only from the official GitHub Releases for this repository.",
    "homepage": "https://github.com/AhmiDarrow/RemedyAI",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "../bin/remedy-desktop"
    ],
    "resources": {
      "../bin/remedy-desktop.exe": "remedy-desktop.exe",
      "../dist": "webui",
      "windows/uninstall_options.ps1": "windows/uninstall_options.ps1",
      "windows/uninstall_wipe.ps1": "windows/uninstall_wipe.ps1",
      "windows/remedy-update-ui.ps1": "windows/remedy-update-ui.ps1"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "endpoints": [
        "https://github.com/AhmiDarrow/RemedyAI/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2MDEwQzVERTNBQ0JDRTAKUldUZ3ZLempYUXdCMWdRNWl0UzlpSDVUamJQZXRvREFpNE9Mb2xJeGpQck5ubVJ5ZDNxSko0dTYK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
