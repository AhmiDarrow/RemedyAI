# Normalize all text files to LF in the repo (was per-machine core.autocrlf,
# which caused endless 'LF will be replaced by CRLF' churn on Windows).
# Working-tree line endings stay per-checkout; committed content is always LF.
* text=auto eol=lf

# Binaries git must never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.exe binary
*.dll binary
*.apk binary
*.keystore binary
*.jks binary
*.woff binary
*.woff2 binary
*.ttf binary
*.sig binary

# Catalog signature is over exact bytes — force LF for portable verify
community/remedy-skills/catalog.json text eol=lf
community/remedy-skills/catalog.json.sig text eol=lf